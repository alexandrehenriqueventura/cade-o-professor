rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções auxiliares ───────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.ativo == true;
    }

    function isCoordenador() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/coordenador/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/coordenador/$(request.auth.token.email.lower())).data.ativo == true;
    }
    // ────────────────────────────────────────────────────────────────────

    // ── admins ───────────────────────────────────────────────────────────
    // Leitura individual (get): próprio documento pelo email ou admin
    // Listagem da coleção (list): apenas admins
    // Escrita: apenas admins
    match /admins/{email} {
      allow get: if isAuthenticated() &&
        (email == request.auth.token.email.lower() || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ── coordenadores ───────────────────────────────────────────────────
    // Leitura individual (get): próprio documento pelo email, admin ou coordenador
    // Listagem da coleção (list): apenas admins
    // Escrita: apenas admins
    match /coordenador/{email} {
      allow get: if isAuthenticated() &&
        (email == request.auth.token.email.lower() || isAdmin() || isCoordenador());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ── professores ──────────────────────────────────────────────────────
    // Leitura pública: alunos podem ver o painel sem login
    // Criação/exclusão: admin ou coordenador
    // Atualização: admin/coordenador tem acesso total;
    //   professor autenticado só pode atualizar seu próprio campo updatedAt
    match /professores/{profId} {
      allow read: if true;
      allow create, delete: if isAdmin() || isCoordenador();
      allow update: if isAdmin() || isCoordenador() ||
        (isAuthenticated() &&
         request.auth.token.email.lower() == resource.data.email.lower() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['updatedAt']));
    }

    // ── salas ────────────────────────────────────────────────────────────
    // Leitura pública: alunos podem ver onde os professores estão
    // Criação/exclusão: admin ou coordenador
    // Atualização: admin/coordenador tem acesso total;
    //   professor autenticado só pode alterar o campo profId para seu próprio
    //   ID (alocação) ou null (saída). A sala só pode ser preenchida se estiver livre,
    //   impedindo sobrescrever a alocação de outro professor.
    match /salas/{salaId} {
      allow read: if true;
      allow create, delete: if isAdmin() || isCoordenador();
      allow update: if isAdmin() || isCoordenador() ||
        (isAuthenticated() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profId']) &&
         (
           // Professor saindo da sala (seta null) — verifica se a sala estava ocupada por ele próprio
           (
             request.resource.data.profId == null &&
             resource.data.profId != null &&
             exists(/databases/$(database)/documents/professores/$(resource.data.profId)) &&
             get(/databases/$(database)/documents/professores/$(resource.data.profId)).data.email.lower() == request.auth.token.email.lower()
           ) ||
           // Professor entrando: só se a sala estiver livre E o profId for o próprio
           (
             request.resource.data.profId is string &&
             resource.data.profId == null &&
             exists(/databases/$(database)/documents/professores/$(request.resource.data.profId)) &&
             get(/databases/$(database)/documents/professores/$(request.resource.data.profId)).data.email.lower() == request.auth.token.email.lower()
           )
         )
        );
    }

    // ── historico ────────────────────────────────────────────────────────
    // Leitura: admin ou coordenador
    // Criação: qualquer usuário autenticado, com campos obrigatórios validados e carimbo do servidor
    // Atualização/exclusão: ninguém — log é imutável
    match /historico/{logId} {
      allow read: if isAdmin() || isCoordenador();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll(['profId','profNome','salaId','salaNome','acao','ts']) &&
        request.resource.data.ts == request.time &&
        request.resource.data.acao in ['entrada', 'saida'] &&
        (
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/professores/$(request.resource.data.profId)) &&
            get(/databases/$(database)/documents/professores/$(request.resource.data.profId)).data.email.lower() == request.auth.token.email.lower()
          )
        );
      allow update, delete: if false;
    }

  }
}
